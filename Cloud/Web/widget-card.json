{
  "type": "AdaptiveCard",
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "selectAction": { "type": "Action.OpenUrl", "url": "${appURL}" },
  "body": [
    { "type": "TextBlock", "text": "🎓  ${term}", "weight": "Bolder", "size": "Small", "isSubtle": true },
    { "type": "ColumnSet", "spacing": "Small", "columns": [
      { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "▣  ${classTitle}", "size": "Small", "maxLines": 1 }] },
      { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${classDetail}", "size": "Small", "isSubtle": true }] }
    ]},
    { "type": "ColumnSet", "spacing": "Small", "columns": [
      { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "☑  ${taskTitle}", "size": "Small", "maxLines": 1 }] },
      { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${taskDetail}", "size": "Small", "isSubtle": true }] }
    ]}
  ]
}
